# Claude API key — optional if ~/.claude credentials are already set up
ANTHROPIC_API_KEY=

# Claude model to use for all agents
CLAUDE_MODEL=claude-sonnet-4-6

# Orchestrator heartbeat interval in seconds (default: 300 = 5 minutes)
HEARTBEAT_INTERVAL=300

# Agent timeout in seconds — ERROR state if exceeded (default: 1800 = 30 minutes)
AGENT_TIMEOUT=1800
